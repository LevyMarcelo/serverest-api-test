{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "quantidade": { "type": "number" },
    "usuarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": { "type": "string", "minLength": 1 },
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 1 },
          "administrador": { "type": "string", "enum": ["true", "false"] },
          "_id": { "type": "string" }
        }
      }
    }
  }
}
